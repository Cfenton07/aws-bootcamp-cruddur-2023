#!/usr/bin/env bash
set -eo pipefail

echo "🔨 Building Frontend Docker Image..."

# ========================================
# BACKEND URL
# ========================================
BACKEND_URL="https://api.fentoncruddur.com"
echo "✅ Using backend URL: $BACKEND_URL"

# ========================================
# COGNITO CONFIGURATION
# ========================================
AWS_REGION="us-east-1"
USER_POOL_ID="us-east-1_wAg3Cr3Px"
CLIENT_ID="12va2n69rq2of98ivm60b9625v"

# ========================================
# API GATEWAY (avatar upload)
# ========================================
# Audit HIGH-07: without this build-arg the bundle bakes "undefined" into the
# avatar upload URL (ProfileForm.js). Public value: it ships to every browser.
API_GATEWAY_URL="https://rtvb6kbife.execute-api.us-east-1.amazonaws.com"

# An empty REACT_APP_* value does not fail the build; it silently produces a
# broken bundle. Refuse to build instead.
for v in BACKEND_URL AWS_REGION USER_POOL_ID CLIENT_ID API_GATEWAY_URL; do
  if [ -z "${!v}" ]; then
    echo "ERROR: required build value ${v} is empty. Aborting." >&2
    exit 1
  fi
done

# ========================================
# BUILD THE IMAGE
# ========================================
echo "🐳 Building Docker image..."

cd frontend-react-js

docker build \
  --build-arg REACT_APP_BACKEND_URL="$BACKEND_URL" \
  --build-arg REACT_APP_AWS_PROJECT_REGION="$AWS_REGION" \
  --build-arg REACT_APP_AWS_COGNITO_REGION="$AWS_REGION" \
  --build-arg REACT_APP_AWS_USER_POOLS_ID="$USER_POOL_ID" \
  --build-arg REACT_APP_CLIENT_ID="$CLIENT_ID" \
  --build-arg REACT_APP_API_GATEWAY_ENDPOINT_URL="$API_GATEWAY_URL" \
  -t frontend-react-js \
  -f Dockerfile.prod \
  .

cd ..

# ========================================
# TAG FOR ECR
# ========================================
ECR_URL="931637612335.dkr.ecr.us-east-1.amazonaws.com/frontend-react-js"
DATE_TAG=$(date +%Y-%m-%d)

echo "🏷️  Tagging image..."
docker tag frontend-react-js:latest $ECR_URL:latest
docker tag frontend-react-js:latest $ECR_URL:$DATE_TAG

# ========================================
# PUSH TO ECR
# ========================================
echo "📤 Pushing to ECR..."
aws ecr get-login-password --region us-east-1 | docker login --username AWS --password-stdin 931637612335.dkr.ecr.us-east-1.amazonaws.com

docker push $ECR_URL:latest
docker push $ECR_URL:$DATE_TAG

echo ""
echo "✅ Frontend build complete!"
echo "   Image: $ECR_URL:latest"
echo "   Image: $ECR_URL:$DATE_TAG"
echo "   Backend URL: $BACKEND_URL"
echo "   API Gateway URL: $API_GATEWAY_URL"
