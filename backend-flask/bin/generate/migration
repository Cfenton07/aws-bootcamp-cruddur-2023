#!/usr/bin/env python3

import time
import os
import sys

if len(sys.argv) == 2:
  name = sys.argv[1]
else:
  print("pass a filename: eg. ./bin/generate/migration add_bio_column")
  exit(1)

# Fixed width (audit HIGH-04). str(time.time()) drops trailing zeros, so about
# 24% of prefixes came out shorter than 17 digits, compared SMALLER than the
# newest applied migration, and were silently skipped by bin/db/migrate.
# time.time_ns() // 100 (units of 100 ns) is always 17 digits until the year 2286.
timestamp = str(time.time_ns() // 100)

filename = f"{timestamp}_{name}.py"

# Convert snake_case to TitleCase for the class name
klass = name.replace("_", " ").title().replace(" ", "")

file_content = f"""from lib.db import db

class {klass}Migration:
  def migrate_sql():
    data = \"\"\"
    \"\"\"
    return data

  def rollback_sql():
    data = \"\"\"
    \"\"\"
    return data

  def migrate():
    db.query_commit({klass}Migration.migrate_sql(), {{}})

  def rollback():
    db.query_commit({klass}Migration.rollback_sql(), {{}})
"""

# Resolve path to the migrations directory
# Script lives at: backend-flask/bin/generate/migration
# Migrations go to: backend-flask/db/migrations/
script_dir = os.path.dirname(os.path.abspath(__file__))
backend_dir = os.path.join(script_dir, '..', '..')
migrations_path = os.path.abspath(os.path.join(backend_dir, 'db', 'migrations', filename))

# Refuse to create a migration that would not run AFTER every existing one
# (for example after a hand-picked prefix such as 17800000000000002).
existing = [int(f.split('_', 1)[0]) for f in os.listdir(os.path.dirname(migrations_path)) if f.split('_', 1)[0].isdigit()]
if existing and int(timestamp) <= max(existing):
  print(f"ERROR: new prefix {timestamp} is not greater than the newest existing prefix {max(existing)}.")
  exit(1)

print(f"Creating migration: {migrations_path}")

# Clean up leading/trailing newlines
file_content = file_content.lstrip('\n').rstrip('\n') + '\n'

with open(migrations_path, 'w') as f:
  f.write(file_content)

print(f"Generated migration: {filename}")